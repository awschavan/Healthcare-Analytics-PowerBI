            "name": "Test Results",
            "dataType": "string",
            "lineageTag": "51b67584-de49-4624-a6ee-91fa084e25ef",
            "sourceColumn": "Test Results",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "bb81d07d-c981-4553-9948-f51675b8ad6c",
        "measures": [
          {
            "name": "Total Admissions",
            "description": "Number of patient admissions in the current filter context.",
            "displayFolder": "1 Volume",
            "expression": "COUNTROWS ( Fact_Admissions )",
            "formatString": "#,0",
            "lineageTag": "08bace40-f9e3-4177-b315-ee671c405b47"
          },
          {
            "name": "Total Discharges",
            "description": "Admissions counted by discharge date (uses the inactive relationship).",
            "displayFolder": "1 Volume",
            "expression": "CALCULATE ( [Total Admissions], USERELATIONSHIP ( Fact_Admissions[Discharge Date], Dim_Date[Date] ) )",
            "formatString": "#,0",
            "lineageTag": "0aacb052-cd9a-4521-9f68-da3c61efc672"
          },
          {
            "name": "Total Patient Days",
            "description": "Sum of length of stay in days.",
            "displayFolder": "1 Volume",
            "expression": "SUM ( Fact_Admissions[Length of Stay] )",
            "formatString": "#,0",
            "lineageTag": "ac0f1300-494f-4819-bb1f-0888dbeffb1b"
          },
          {
            "name": "Admissions % of Total",
            "description": "Share of admissions within the currently selected slicers.",
            "displayFolder": "1 Volume",
            "expression": "DIVIDE ( [Total Admissions], CALCULATE ( [Total Admissions], ALLSELECTED () ) )",
            "formatString": "0.0%",
            "lineageTag": "87473b33-03d9-4280-b99e-cc7e51a30e76"
          },
          {
            "name": "Total Billing",
            "description": "Total billed amount.",
            "displayFolder": "2 Billing",
            "expression": "SUM ( Fact_Admissions[Billing Amount] )",
            "formatString": "$#,0",
            "lineageTag": "ea32a957-7bfc-4b02-81d5-8bd79dbd6a5b"
          },
          {
            "name": "Avg Billing per Admission",
            "description": "Average bill per admission.",
            "displayFolder": "2 Billing",
            "expression": "DIVIDE ( [Total Billing], [Total Admissions] )",
            "formatString": "$#,0",
            "lineageTag": "473871d8-2794-4621-a304-5c08ddbbc803"
          },
          {
            "name": "Avg Billing per Day",
            "description": "Average billing per patient day.",
            "displayFolder": "2 Billing",
            "expression": "DIVIDE ( [Total Billing], [Total Patient Days] )",
            "formatString": "$#,0",
            "lineageTag": "7f2cb5c5-ead4-4314-a312-b37414fd69c3"
          },
          {
            "name": "Avg Length of Stay",
            "description": "Average length of stay in days.",
            "displayFolder": "3 Clinical",
            "expression": "AVERAGE ( Fact_Admissions[Length of Stay] )",
            "formatString": "0.0",
            "lineageTag": "7b306609-10f9-4b67-a844-9f9739f97389"
          },
          {
            "name": "Avg Patient Age",
            "description": "Average patient age in years.",
            "displayFolder": "3 Clinical",
            "expression": "AVERAGE ( Fact_Admissions[Age] )",
            "formatString": "0.0",
            "lineageTag": "55ea95ce-c046-40c4-babc-5d6ce01ed41a"
          },
          {
            "name": "Abnormal Results",
            "description": "Admissions with an abnormal test result.",
            "displayFolder": "3 Clinical",
            "expression": "CALCULATE ( [Total Admissions], Fact_Admissions[Test Results] = \"Abnormal\" )",
            "formatString": "#,0",
            "lineageTag": "cd0acaca-72a3-45c5-9074-ee1e49cbfc02"
          },
          {
            "name": "Abnormal Result Rate",
            "description": "Share of admissions with an abnormal test result.",
            "displayFolder": "3 Clinical",
            "expression": "DIVIDE ( [Abnormal Results], [Total Admissions] )",
            "formatString": "0.0%",
            "lineageTag": "a1acde49-4545-4be7-ba21-bf484673d373"
          },
          {
            "name": "Emergency Admissions",
            "description": "Admissions of type Emergency.",
            "displayFolder": "3 Clinical",
            "expression": "CALCULATE ( [Total Admissions], Fact_Admissions[Admission Type] = \"Emergency\" )",
            "formatString": "#,0",
            "lineageTag": "130c0e25-6cdf-4651-aa9c-066c5c7e17f6"
          },
          {
            "name": "Emergency Admission %",
            "description": "Share of admissions that are emergencies.",
            "displayFolder": "3 Clinical",
            "expression": "DIVIDE ( [Emergency Admissions], [Total Admissions] )",
            "formatString": "0.0%",
            "lineageTag": "5e263d01-ea25-458f-84f8-6f574916f6f5"
          },
          {
            "name": "Admissions PY",
            "description": "Admissions in the same period last year. Note: 2019 and 2024 are partial years.",
            "displayFolder": "4 Time Intelligence",
            "expression": "CALCULATE ( [Total Admissions], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )",
            "formatString": "#,0",
            "lineageTag": "5e1e5f79-99d0-40f8-bf0b-4671dda1d793"
          },
          {
            "name": "Admissions YoY %",
            "description": "Year-over-year change in admissions. Best read at month level.",
            "displayFolder": "4 Time Intelligence",
            "expression": "DIVIDE ( [Total Admissions] - [Admissions PY], [Admissions PY] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "fd9b0fa6-3ff5-490d-a280-0daed30bf32c"
          },
          {
            "name": "Billing PY",
            "description": "Billing in the same period last year.",
            "displayFolder": "4 Time Intelligence",
            "expression": "CALCULATE ( [Total Billing], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )",
            "formatString": "$#,0",
            "lineageTag": "f5a8629b-31f5-4c1f-a361-6fffaf5b37c3"
          },
          {
            "name": "Billing YoY %",
            "description": "Year-over-year change in billing. Best read at month level.",
            "displayFolder": "4 Time Intelligence",
            "expression": "DIVIDE ( [Total Billing] - [Billing PY], [Billing PY] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "51e227ec-57e0-468c-bb8f-6005423f39bb"
          }
        ],
        "partitions": [
          {
            "name": "Fact_Admissions",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\fact_admissions.csv\"), [Delimiter=\",\", Columns=19, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Admission ID\", Int64.Type}, {\"Patient Name\", type text}, {\"Age\", Int64.Type}, {\"Age Group\", type text}, {\"Age Group Order\", Int64.Type}, {\"Gender\", type text}, {\"Blood Type\", type text}, {\"Medical Condition\", type text}, {\"Admission Date\", type date}, {\"Discharge Date\", type date}, {\"Length of Stay\", Int64.Type}, {\"Admission Type\", type text}, {\"Doctor\", type text}, {\"Hospital\", type text}, {\"Insurance Provider\", type text}, {\"Billing Amount\", type number}, {\"Room Number\", Int64.Type}, {\"Medication\", type text}, {\"Test Results\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
